// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  // Local dev keeps using the plain file (set in .env as
  // DATABASE_URL="file:dev.sqlite"). In production (Fly.io) this points at
  // a path on the persistent volume instead — see fly.toml /
  // Dockerfile.
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id                    String    @id @default(cuid())
  shop                  String    @unique
  weeklyAlertEnabled    Boolean   @default(false)
  shippingCostPerOrder  Float     @default(5.0)
  targetMarginPercent   Float     @default(20)
  notificationEmail     String?
  // Review-request banner (dashboard): null = never interacted with it.
  // Set when the merchant clicks "Leave a Quick Review" — banner never
  // shows again for this shop once this is set.
  reviewBannerDismissedAt DateTime?
  // Set when the merchant clicks "Remind Me Later" — banner stays hidden
  // until this timestamp passes, then becomes eligible to show again.
  reviewBannerRemindAt    DateTime?
}

// One row per completed scan. Lets the dashboard show a merchant their
// health-score/leak trend over time instead of only "right now" — the
// "prove we're actually saving you money" ask.
model AuditSnapshot {
  id               String   @id @default(cuid())
  shop             String
  scannedAt        DateTime @default(now())
  healthScore      Int
  totalMonthlyLeak Float
  currencyCode     String

  @@index([shop, scannedAt])
}

// Free-text feedback submitted from inside the app.
model Feedback {
  id        String   @id @default(cuid())
  shop      String
  message   String
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
